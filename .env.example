# --- ONION-PIPE RELAY PRODUCTION ENV ---

# 1. Dashboard Admin Security
# Access the management dashboard at /admin
ADMIN_USER=LOOHIVE_admin
ADMIN_PASSWORD=your_very_secure_admin_password
SESSION_SECRET=a_long_random_string_for_session_encryption

# 2. GitHub OAuth (Get these from https://github.com/settings/developers)
# Homepage URL: https://onion-pipe.loohive.com
# Authorization callback URL: https://onion-pipe.loohive.com/auth/github/callback
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# 3. Network Configuration
# The public base URL of your relay instance
PUBLIC_RELAY_URL=https://onion-pipe.loohive.com

# 4. Registration Security
# Optional: Secret required by CLI users to register their tunnels
REGISTRATION_SECRET=optional_shared_secret_to_limit_cli_registrations

# 5. Persistence
# Example: redis://redis:6379 (for docker-compose) or redis://localhost:6379
REDIS_URL=redis://redis:6379
